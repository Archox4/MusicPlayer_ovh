<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ControlsSliderButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MixerRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource ControlsSliderButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                  ShadowDepth="0" 
                                  Color="#1DB954" 
                                  Opacity="0.6" />
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MixerSlider" TargetType="{x:Type Slider}">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="IsMoveToPointEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Margin="0,5">
                        <Grid.Resources>
                            <Style x:Key="SliderButton" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource ControlsSliderButtonStyle}"/>
                        </Grid.Resources>
                        <Border                          
                        Background="Transparent" 
                        Height="{TemplateBinding Height}"
                        BorderThickness="0"
                        VerticalAlignment="Center"/>

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MixerRepeatButton}"
                                IsHitTestVisible="False"
                                Background="#1DB954" MinWidth="20"/>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderButton}" 
                                IsHitTestVisible="False"
                                Background="Transparent"/>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb x:Name="Thumb" IsHitTestVisible="True">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Width="12" Height="12" Fill="#1DB954"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>