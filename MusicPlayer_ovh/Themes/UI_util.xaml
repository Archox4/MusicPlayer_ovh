<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <Style x:Key="PathButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#333" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8,0,0,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>


        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#444" />
                <Setter Property="BorderBrush" Value="#222"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#222" />
                <Setter Property="BorderBrush" Value="Gray"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#555" />
                <Setter Property="Foreground" Value="DarkGray"/>
                <Setter Property="BorderBrush" Value="#777"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PathButtonStyleOpenExplorer" TargetType="Button" BasedOn="{StaticResource PathButtonStyle}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0,8,8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="ImageRounded" TargetType="Button">
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                    BorderBrush="#1E1E1E"
                    Background="#1E1E1E"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect/>
                        </Border.Effect>

                        <Grid ClipToBounds="True">
                            <Image Source="{TemplateBinding Content}" 
                                   Stretch="UniformToFill" 
                                   ClipToBounds="True" 
                                   Width="{TemplateBinding Width}" 
                                   Height="{TemplateBinding Height}" >
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,120,120"/>
                                </Image.Clip>
                            </Image>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>