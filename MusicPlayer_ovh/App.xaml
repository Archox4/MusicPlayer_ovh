<Application x:Class="MusicPlayer_ovh.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicPlayer_ovh"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="FontAwesomeSolid">/Resources/Fonts/#Font Awesome 6 Free Solid</FontFamily>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Themes/MusicListStyle.xaml"/>
                <ResourceDictionary Source="/Themes/UI_util.xaml"/>
                <ResourceDictionary Source="/Themes/Nav_util.xaml"/>
                <ResourceDictionary Source="/Themes/Mixer_util.xaml"/>
                <ResourceDictionary Source="/Themes/Controls_util.xaml"/>
                <ResourceDictionary Source="/Themes/SidePanel.xaml"/>
                
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
